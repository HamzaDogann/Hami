# Hugging Face access token (server-side only, never exposed to the browser).
# Create one at https://huggingface.co/settings/tokens/new?tokenType=fineGrained
# and enable "Make calls to Inference Providers".
HF_TOKEN=

# Optional: override the chat model (default: openai/gpt-oss-120b, then openai/gpt-oss-20b and google/gemma-4-31B-it)
# HF_TEXT_MODEL=openai/gpt-oss-120b
